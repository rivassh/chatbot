# Chatbot Configuration
# Copy this file to .env and customize for your topic

# Server
PORT=3458

# Bot Identity
BOT_NAME=دانا

# Topic Configuration
TOPIC=games
TOPIC_TITLE=چت‌بات ارتقاء بازی
TOPIC_ICON=🎮

# Sidebar Items (JSON array)
SIDEBAR_ITEMS=[{"icon":"🐍","name":"مار نئون","url":"/game-platform/"},{"icon":"♟","name":"شطرنج","url":"/games/chess/"},{"icon":"🎲","name":"آمیرزا","url":"/games/game2/web/"}]

# Quick Actions (JSON array)
QUICK_ACTIONS=["+ قدرت ویژه","+ صدا","+ تم جدید","رفع باگ","📱 موبایل"]

# Games File (optional - for dynamic sidebar)
# GAMES_FILE=games.json

